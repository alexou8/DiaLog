# The repository root is a Next.js application; the Python research pipeline
# lives under ml/. Python packaging patterns are scoped to ml/ so that they
# cannot swallow application directories — an unscoped `lib/` from the standard
# Python template previously excluded the entire application core.

# --- Node / Next.js ------------------------------------------------------
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.vercel/

# --- Environment and secrets --------------------------------------------
.env
.env.*
!.env.example

# --- Test output ---------------------------------------------------------
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
tests/e2e/.auth/

# --- Editor / OS ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Logs ----------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Python research pipeline (ml/) --------------------------------------
ml/**/__pycache__/
ml/**/*.py[codz]
ml/.venv/
ml/venv/
ml/.pytest_cache/
ml/.hypothesis/
ml/.coverage
ml/coverage.xml
ml/htmlcov/
ml/*.egg-info/
ml/dialog_ml.egg-info/
ml/build/
ml/dist/
ml/.mypy_cache/
ml/.ruff_cache/

# Generated model artefacts and pipeline output (the .gitkeep files stay).
ml/models/*
!ml/models/.gitkeep
ml/outputs/*
!ml/outputs/.gitkeep
ml/dialog.sqlite
ml/data/processed_dataset.csv

# --- Local scratch -------------------------------------------------------
debug_*.mjs
