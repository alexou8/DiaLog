# --- Database -------------------------------------------------------------
# PostgreSQL connection string. On Vercel use a pooled connection URL.
DATABASE_URL="postgresql://postgres:dialog@127.0.0.1:5432/dialog?schema=public"
# REQUIRED. Direct (non-pooled) URL used by `prisma migrate`. It is not optional:
# prisma/schema.prisma declares `directUrl = env("DIRECT_DATABASE_URL")`, so every
# Prisma CLI command (generate, migrate, studio, validate) errors while it is
# unset. If you have no pooler, set it to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:dialog@127.0.0.1:5432/dialog?schema=public"

# Test databases are separate on purpose and are NOT read from DATABASE_URL:
#   npm run test:integration  ->  TEST_DATABASE_URL  (must be named dialog_test)
#   npm run test:e2e          ->  E2E_DATABASE_URL   (must be named dialog_e2e or dialog_test)
# Both suites delete data and refuse any other database name, so they can never
# be pointed at the `dialog` database above. Defaults are local Postgres with
# the password above; create the databases and run
# `DATABASE_URL=<url> DIRECT_DATABASE_URL=<url> npx prisma migrate deploy` against
# each once (migrate uses DIRECT_DATABASE_URL, so setting only DATABASE_URL would
# migrate the wrong database).
# TEST_DATABASE_URL="postgresql://postgres:dialog@127.0.0.1:5432/dialog_test?schema=public"
# E2E_DATABASE_URL="postgresql://postgres:dialog@127.0.0.1:5432/dialog_e2e?schema=public"

# --- Authentication -------------------------------------------------------
# 32+ byte random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- Password recovery email ---------------------------------------------
# console prints links ONLY in development; tests capture in memory.
# Production must select http and configure an authenticated mail relay.
EMAIL_PROVIDER="console"
EMAIL_HTTP_URL=""
EMAIL_HTTP_TOKEN=""
EMAIL_FROM=""
# NEXT_PUBLIC_APP_URL (see "Misc" below) is REQUIRED for password recovery: reset
# links are built from it. It must be your trusted public origin (HTTPS except
# local loopback) and is never derived from the request Host header.

# --- Authentication: Google sign-in (optional; the app works without it) --
# Leave both empty to disable "Sign in with Google" entirely — password auth
# still works. To enable it, create an OAuth 2.0 Client ID (Web application)
# in the Google Cloud Console and register this authorised redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI (all optional; the app works fully without them) ------------------
# One of: anthropic | openai | local   (default: local — no data leaves the server)
AI_PROVIDER="local"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Misc -----------------------------------------------------------------
# Required for password recovery (reset links are built from it) and for the
# Google redirect URI. Set it to the public origin in every deployed environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
