# --- Database -------------------------------------------------------------
# PostgreSQL connection string. On Vercel use a pooled connection URL.
DATABASE_URL="postgresql://postgres:dialog@127.0.0.1:5432/dialog?schema=public"
# Optional direct (non-pooled) URL used only by `prisma migrate`.
DIRECT_DATABASE_URL="postgresql://postgres:dialog@127.0.0.1:5432/dialog?schema=public"

# --- Authentication -------------------------------------------------------
# 32+ byte random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- Authentication: Google sign-in (optional; the app works without it) --
# Leave both empty to disable "Sign in with Google" entirely — password auth
# still works. To enable it, create an OAuth 2.0 Client ID (Web application)
# in the Google Cloud Console and register this authorised redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI (all optional; the app works fully without them) ------------------
# One of: anthropic | openai | local   (default: local — no data leaves the server)
AI_PROVIDER="local"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Misc -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
